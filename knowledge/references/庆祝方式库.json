{
  "source": "knowledge/chapters/10-附录与行为设计工具箱.md，PDF 第 330–335 页",
  "count": 100,
  "items": [
    {
      "id": 1,
      "text": "挥舞拳头，肯定地说：“Yes！”"
    },
    {
      "id": 2,
      "text": "轻轻敲击墙面或桌面，奏出轻快的节拍。"
    },
    {
      "id": 3,
      "text": "想象妈妈给了你一个大大的拥抱。"
    },
    {
      "id": 4,
      "text": "微微点头。"
    },
    {
      "id": 5,
      "text": "假装投进三分球。"
    },
    {
      "id": 6,
      "text": "想象烟花为你而绽放。"
    },
    {
      "id": 7,
      "text": "展露一个大大的微笑。"
    },
    {
      "id": 8,
      "text": "双手比赞。"
    },
    {
      "id": 9,
      "text": "画一个笑脸，感受它传递的情绪。"
    },
    {
      "id": 10,
      "text": "哼几句轻快的歌词。"
    },
    {
      "id": 11,
      "text": "想想你最喜欢的老师对你说：“你做得很好！”"
    },
    {
      "id": 12,
      "text": "举起双手，摆出胜利的姿势，同时说：“胜利！”"
    },
    {
      "id": 13,
      "text": "想想你最好的朋友为你感到高兴。"
    },
    {
      "id": 14,
      "text": "稍微按摩一下肩膀或脖子。"
    },
    {
      "id": 15,
      "text": "心想：没错，我快要成功地做出改变了！"
    },
    {
      "id": 16,
      "text": "想象自己打开了一份包装漂亮的感谢礼物。"
    },
    {
      "id": 17,
      "text": "说：“我说到做到了！”"
    },
    {
      "id": 18,
      "text": "跳几下甩手舞。"
    },
    {
      "id": 19,
      "text": "撒出想象中五彩缤纷的小纸片。"
    },
    {
      "id": 20,
      "text": "说：“我搞定了！”"
    },
    {
      "id": 21,
      "text": "握紧拳头，说：“Yes！”"
    },
    {
      "id": 22,
      "text": "对着镜子里的自己微笑。"
    },
    {
      "id": 23,
      "text": "挥舞拳头，说：“太棒了！”"
    },
    {
      "id": 24,
      "text": "听到人群欢呼。"
    },
    {
      "id": 25,
      "text": "对自己说：“干得好！”"
    },
    {
      "id": 26,
      "text": "双手合十，表示感谢。"
    },
    {
      "id": 27,
      "text": "说：“搞定了！”然后打个响指。"
    },
    {
      "id": 28,
      "text": "双手自然垂下，挺起胸膛。"
    },
    {
      "id": 29,
      "text": "对自己说：“没错！我很擅长培养习惯。”"
    },
    {
      "id": 30,
      "text": "骄傲和雀跃地在房间里昂首阔步。"
    },
    {
      "id": 31,
      "text": "说或想：“干得好！”"
    },
    {
      "id": 32,
      "text": "握拳，敲打心脏位置3次。"
    },
    {
      "id": 33,
      "text": "想象一位老师为你颁奖。"
    },
    {
      "id": 34,
      "text": "想象你的孩子在冲着你笑。"
    },
    {
      "id": 35,
      "text": "以不同方式挥舞拳头。"
    },
    {
      "id": 36,
      "text": "跳一段庆祝舞。"
    },
    {
      "id": 37,
      "text": "在心里告诉自己：“是的，我能行！”"
    },
    {
      "id": 38,
      "text": "想象巧克力的味道。"
    },
    {
      "id": 39,
      "text": "看亮黄色的事物。"
    },
    {
      "id": 40,
      "text": "高兴地搓搓手。"
    },
    {
      "id": 41,
      "text": "想象父亲对你说：“哇！你太优秀了！”"
    },
    {
      "id": 42,
      "text": "双手握拳，碰到一起后像炸开一样。"
    },
    {
      "id": 43,
      "text": "给自己击掌。"
    },
    {
      "id": 44,
      "text": "听听脑海里的号角声。"
    },
    {
      "id": 45,
      "text": "模仿玛莎·斯图尔特的语气说：“这很不错。”"
    },
    {
      "id": 46,
      "text": "打响指。"
    },
    {
      "id": 47,
      "text": "想象自己收到了新工作的聘用通知。"
    },
    {
      "id": 48,
      "text": "说：“你做到了！”"
    },
    {
      "id": 49,
      "text": "扬起下巴，对着远方微笑。"
    },
    {
      "id": 50,
      "text": "想象掌声雷动。"
    },
    {
      "id": 51,
      "text": "说：“真好！”然后点点头。"
    },
    {
      "id": 52,
      "text": "休息一下，深呼吸，感恩你的成功。"
    },
    {
      "id": 53,
      "text": "举起双手，高呼：“耶！耶！耶！”"
    },
    {
      "id": 54,
      "text": "反复竖起大拇指。"
    },
    {
      "id": 55,
      "text": "说：“我超喜欢它！”"
    },
    {
      "id": 56,
      "text": "高唱：“Celebrate good times, come on！”"
    },
    {
      "id": 57,
      "text": "赞美自己：“我很擅长……”"
    },
    {
      "id": 58,
      "text": "用口哨吹出轻快的旋律。"
    },
    {
      "id": 59,
      "text": "吐一口气，然后说：“Yes！”"
    },
    {
      "id": 60,
      "text": "骄傲地拍拍肩膀。"
    },
    {
      "id": 61,
      "text": "为自己鼓掌。"
    },
    {
      "id": 62,
      "text": "想象你爱的人给了你一个大大的拥抱。"
    },
    {
      "id": 63,
      "text": "拉长尾音，说：“Yes——！”"
    },
    {
      "id": 64,
      "text": "心想：“做得好！”"
    },
    {
      "id": 65,
      "text": "摆出一个充满能量的姿势。"
    },
    {
      "id": 66,
      "text": "想象看到爱人时自己的表情。"
    },
    {
      "id": 67,
      "text": "上下挥舞双手。"
    },
    {
      "id": 68,
      "text": "摆出大力水手的姿势。"
    },
    {
      "id": 69,
      "text": "深吸一口气，想象自己吸收了能量。"
    },
    {
      "id": 70,
      "text": "做几秒“骚灵手指”。"
    },
    {
      "id": 71,
      "text": "说：“达阵！”然后像裁判一样举起双手。"
    },
    {
      "id": 72,
      "text": "嗅一嗅鲜花的芳香（但前提是你附近有鲜花）。"
    },
    {
      "id": 73,
      "text": "想象自己正在最喜欢的海滩上。"
    },
    {
      "id": 74,
      "text": "优雅地鞠躬。"
    },
    {
      "id": 75,
      "text": "和你的孩子击掌。"
    },
    {
      "id": 76,
      "text": "想象老虎机中头奖时发出的声音。"
    },
    {
      "id": 77,
      "text": "看着镜子里的自己说：“我真为你骄傲！”"
    },
    {
      "id": 78,
      "text": "拍拍胸脯。"
    },
    {
      "id": 79,
      "text": "边走边唱：“S-U-C-C-E-S-S！”这就是我拼写“成功”的方式。"
    },
    {
      "id": 80,
      "text": "唱：“Hey now, you’re a rock star.”"
    },
    {
      "id": 81,
      "text": "想想你和宠物狗一起玩耍时的美好感觉。"
    },
    {
      "id": 82,
      "text": "摆出尤塞恩·博尔特（Usain Bolt）赢得短跑冠军后做出的姿势。"
    },
    {
      "id": 83,
      "text": "与自己击掌。"
    },
    {
      "id": 84,
      "text": "想象内心的微笑。"
    },
    {
      "id": 85,
      "text": "摆一个功夫小子的招牌姿势。"
    },
    {
      "id": 86,
      "text": "露出灿烂的笑容，并欢呼：“耶！耶！”"
    },
    {
      "id": 87,
      "text": "拍拍自己的背。"
    },
    {
      "id": 88,
      "text": "打几下响指。"
    },
    {
      "id": 89,
      "text": "张开双臂，想象自己正在拥抱改变。"
    },
    {
      "id": 90,
      "text": "小声说：“感恩。”"
    },
    {
      "id": 91,
      "text": "像电影明星一样，抛出一个飞吻。"
    },
    {
      "id": 92,
      "text": "让身体旋转一圈。"
    },
    {
      "id": 93,
      "text": "说：“好极了！”"
    },
    {
      "id": 94,
      "text": "想象你有一条尾巴，欢快地摇来摇去。"
    },
    {
      "id": 95,
      "text": "做出一个和平的手势，说（或想）：“胜利了！”"
    },
    {
      "id": 96,
      "text": "抱拳鞠躬。"
    },
    {
      "id": 97,
      "text": "和镜子里的自己击掌。"
    },
    {
      "id": 98,
      "text": "想象自己身上有一圈闪闪发光的光环。"
    },
    {
      "id": 99,
      "text": "大声笑。"
    },
    {
      "id": 100,
      "text": "模仿动画《摩登原始人》里的经典台词：“Yabba dabba doo！”"
    }
  ]
}